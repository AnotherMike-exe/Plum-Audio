# Plum-Audio — per-unit environment. deploy.sh generates one of these per Pi from units.conf and
# installs it next to docker-compose.yml; copy this file to plum-audio.env to run a unit by hand.
#
# Everything here has a working default in the image (the entrypoint derives the unit identity from
# the hostname and the LAN address). What you set here is what must be STABLE across rebuilds:
# a unit id the mesh has already learned, and the DAC.

# --- Binhex ---------------------------------------------------------------------------------
PUID=1000
PGID=1000
UMASK=002
TZ=America/New_York
DEBUG=false

# --- Mesh identity ---------------------------------------------------------------------------
# Stable per unit. Peers key routing and group membership off these, so renaming a live unit looks
# to the mesh like the old one vanished and a new one appeared.
PLUM_UNIT_ID=unit-210
PLUM_UNIT_NAME=Pi4-02
PLUM_LOCAL_PLAYER_ID=player-210
PLUM_PLAYER_NAME=Player-210

# Advertised player URL. Leave unset and the entrypoint fills in ws://<this unit's LAN IP>:8928 —
# override only for a unit with several interfaces where the wrong one would be picked.
#PLUM_LOCAL_PLAYER_URL=ws://192.0.2.10:8928/sendspin

# --- Audio ------------------------------------------------------------------------------------
# The onboard DAC on a Pi. `docker exec plum-audio aplay -l` lists the alternatives.
PLUM_DAC_DEVICE=bcm2835
# Player-side output latency padding, in ms; the jitter buffer that makes a cross-server roam
# inaudible sits on top of this.
PLUM_STATIC_DELAY_MS=150
# Silence before a source announces itself stopped (group.stop()), in seconds.
PLUM_SOURCE_IDLE_TIMEOUT=300

# --- Misc --------------------------------------------------------------------------------------
PLUM_LOG_LEVEL=INFO
PLUM_MESH_ENABLED=1
# Plexamp is a Debian sidecar that is not in the image yet; leave off.
PLEXAMP_ENABLED=0

# --- Access ------------------------------------------------------------------------------------
# Extra browser origins allowed to call this unit's APIs, comma-separated and ABSOLUTE
# (`http://host:port`). By default a unit accepts pages served from itself or from any unit in its
# mesh — by IP or by hostname, on any port — and nothing else. Add a dev server or a reverse proxy
# here. Requests with no Origin (peer-to-peer, the loopback player) are never affected.
#
#   PLUM_ALLOWED_ORIGINS=http://dev-box:5173
#
# `*` restores the old blanket behaviour. It is a get-out-of-jail lever, not a setting: a unit whose
# GUI is dead is worse than one reachable from the wrong page, and it needs no rebuild to apply.
#   PLUM_ALLOWED_ORIGINS=*
PLUM_ALLOWED_ORIGINS=

# Accept cleartext Sendspin clients. aiosendspin 9.x defaults this OFF and calls the cleartext path
# "non-spec transition mode" — for us it is a standing requirement, not a transitional one, because
# sendspin-cpp (what ESPHome's Sendspin component, the HA Voice PE and the Esparagus/Satellite1
# boards all run) has no Noise support in any release, and our own web GUI talks to :8927 as a
# hand-rolled cleartext WebSocket with no proxy in front of it.
#
# Setting this to 0 drops every third-party speaker on the LAN, Music Assistant, AND the GUI. It
# only becomes safe to turn off once sendspin-cpp ships encryption and the GUI is migrated with it.
# Note this is a SERVER-side concession: our own player is an aiosendspin client and always speaks
# Noise, so it is unaffected either way.
PLUM_ALLOW_UNENCRYPTED=1

# Whether an ENCRYPTED-but-unpaired client may play — the sentinel-PSK path, which is encrypted but
# UNAUTHENTICATED and which the spec explicitly calls man-in-the-middle vulnerable. Off by default
# now that real pairing exists: a unit pairs with its own speaker automatically, and everything else
# pairs from the GUI.
#
# This is the DEPLOY-TIME default only. A choice made in the GUI is written to settings.json and
# outranks this from then on, surviving reboots and upgrades — the same precedence as PLUM_DAC_DEVICE.
# Turning it on is a way to get a mesh working before pairing, not a setting to leave on.
#
# It has no effect on cleartext clients (ESP32 speakers, Music Assistant, this unit's own web GUI),
# which are activated without pairing regardless. See docs/SENDSPIN-PAIRING.md.
PLUM_UNPAIRED_ACCESS=0

# An optional STATIC pairing PIN for this unit's speaker, offered alongside the dynamic PIN. Must be
# exactly 8 digits (the spec's fixed length) or it is refused with a log line rather than padded.
# Every static-PIN attempt is still gesture-gated, so this is convenience, not unattended pairing.
#PLUM_STATIC_PIN=31415926

# Where this unit's X25519 keypairs and pairing/trust store live. Defaults to /config/identity, and
# there is normally no reason to move it. Treat the contents as a device certificate: losing
# server.key makes this unit a stranger to every peer, and losing player.key makes its speaker
# untrusted by every server including its own.
#   PLUM_IDENTITY_DIR=/config/identity

# Set to 0 for a unit with no audio output — no player process at all. deploy.sh writes this from a
# units.conf DAC column of `none`; the entrypoint also sets it from output_gate.py's decision.
PLUM_PLAYER_ENABLED=1
