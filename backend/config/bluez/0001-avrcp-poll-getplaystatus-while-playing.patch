+
+/*
+ * Plum-Audio: poll GetPlayStatus while playing.
+ *
+ * GetPlayStatus (PDU 0x30) is the only way to obtain a REAL measured position from the target;
+ * MediaPlayer1.Position is otherwise a local wall-clock interpolation from the last notification
+ * (and is unclamped, so it drifts past the end of the track). Upstream issues GetPlayStatus only
+ * from the GetCapabilities response, a status change, a track change and the media player list
+ * parse, and exposes no D-Bus method that triggers one, so a mid-track scrub on the phone can
+ * never reach a D-Bus client. Polling closes that hole even against a target that does not
+ * support EVENT_PLAYBACK_POS_CHANGED at all (iOS commonly does not advertise it).
+ *
+ * Only while the player reports "playing": a scrub made while paused is picked up by the
+ * status change that resumption produces, and an idle link stays quiet.
+ */
+static bool poll_play_status(gpointer user_data)
+{
+	struct avrcp *session = user_data;
+	struct avrcp_player *player;
+	struct media_player *mp;
+
+	if (!session->controller || !session->controller->player) {
+		session->pos_timer = 0;
+		return FALSE;
+	}
+
+	player = session->controller->player;
+	mp = player->user_data;
+
+	if (mp && g_strcmp0(media_player_get_status(mp), "playing") == 0)
+		avrcp_get_play_status(session);
+
+	return TRUE;
 }
 
+static void avrcp_start_position_poll(struct avrcp *session)
+{
+	if (session->pos_timer > 0)
+		return;
+
+	session->pos_timer = timeout_add_seconds(AVRCP_POSITION_POLL,
+						poll_play_status, session, NULL);
+}
+
 static const char *status_to_str(uint8_t status)
