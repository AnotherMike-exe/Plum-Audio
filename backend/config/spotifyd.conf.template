# Plum-Audio spotifyd instance template.
# Rendered per Spotify Connect endpoint by scripts/sources/spotify_config.py — one config +
# one spotifyd process per endpoint, with values substituted from the settings.json
# integrations.spotify endpoints.
#
# Audio path: spotifyd's pipe backend writes raw PCM to the instance FIFO, which the in-process
# SendspinServer feeder reads and pushes into that source's group (no snapserver, no tee).
# Format is S16 / 44100 / stereo to match the feeder's DEFAULT_FORMAT.
[global]
device_name = "SPOTIFY_NAME"
device_id = "SPOTIFY_DEVICE_ID"
backend = "pipe"
device = "/tmp/spotify-INSTANCE_ID-fifo"
cache_path = "/tmp/spotify-INSTANCE_ID-cache"
zeroconf_port = SPOTIFY_ZEROCONF_PORT
use_mpris = true
dbus_type = "system"
bitrate = SPOTIFY_BITRATE
audio_format = "S16"
device_type = "speaker"
volume_normalisation = false
initial_volume = 100
