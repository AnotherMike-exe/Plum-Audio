# Plum-Audio frontend — copy to .env for local dev.
# Bootstrap URL for the mesh REST API (GET /api/mesh/view + route/volume POSTs). In production this
# is a relative /api/mesh proxied to a unit's :5001; for local `npm run dev` against a real unit,
# point it at that unit's mesh API. After the first /view, per-unit hosts from the view drive the
# rest (controller WS per unit at ws://<host>:8927, POSTs to http://<host>:5001).
VITE_MESH_API_URL=/api/mesh
# Example against a live unit:
# VITE_MESH_API_URL=http://192.0.2.10:5001/api/mesh
