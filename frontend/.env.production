# Production build (npm run build) — served BY a unit, so every API is same-origin and nginx
# proxies it. These MUST stay empty: Vite inlines env values at build time, so a dev .env pointing
# at one unit would bake that unit's address into the artifact and every unit's page would show
# that unit (its name, its player, its sources). Empty = fall back to the relative /api/* paths.
VITE_MESH_API_URL=
VITE_SETTINGS_API_URL=
