# Plum-Audio — apply an update request. Triggered by plum-updater.path, or run by hand.
#
# Type=oneshot and no Restart=: a failed update must stay failed and visible in the state file, not
# retry in a loop against a registry that is unreachable. The agent records the failure and leaves
# the running container alone.
[Unit]
Description=Plum-Audio update agent
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/plum-updater.sh watch
# The pull is the long part and a Pi on a slow link is normal. Well under the 600 s after which the
# container's API reports the request as stale, so a genuine hang still surfaces in the GUI.
TimeoutStartSec=420
StandardOutput=journal
StandardError=journal
# A sandbox for the agent, which is root. Each setting here leaves `docker compose` working: the
# docker CLI only talks to /run/docker.sock, and the daemon does the privileged work in its own
# unit. The script writes only below /opt/plum-audio and /var/lib/plum-audio.
#   - ProtectHome is `read-only`, NOT `yes`: the docker CLI reads /root/.docker/config.json for a
#     registry login, and `yes` hides that file.
#   - ProtectSystem=, ProtectControlGroups= and PrivateNetwork= are left out on purpose. They are
#     not tested on a unit with `docker compose`.
NoNewPrivileges=yes
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
