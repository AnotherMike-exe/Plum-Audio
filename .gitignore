# Development resources (NOT in version control)
_resources/

# Dependencies
node_modules/
vendor/
__pycache__/
*.pyc
.venv/
venv/

# Build output
dist/
build/
*.compiled
*.egg-info/

# Environment files
.env
.env.local
.env.*.local

# Rig-local, never published: the deploy credential and the real unit table.
# Ship-able templates live beside them as docker/units.conf.example / plum-audio.env.example.
docker/.deploy.env
docker/units.conf

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / agent tooling. settings.local.json records local permission grants, which have
# historically included rig credentials — never let it reach a public remote.
.vscode/
.idea/
.claude/settings.local.json
*.swp
*.swo
*.sublime-*

# Test coverage
coverage/
.nyc_output/
.pytest_cache/
htmlcov/

# Docker volumes (local development) — anchored to root so backend/config/ stays tracked
app-config/
app-data/
app-media/
/config/
/data/
/media/

# Temporary files
tmp/
temp/
*.tmp

# macOS AppleDouble sidecars (scp from a Mac creates these on the rigs too)
._*
